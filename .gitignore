# ----------------------------------------------------------------------------
# Project : Firefox Network Log Recorder
# Author  : AMiran Kimadze (itsarmen) — https://github.com/itsarmen
# ----------------------------------------------------------------------------
# Git tracks source code, branding assets and the root README/LICENSE.
# Build outputs, local data, secrets, and doc/spec clutter stay out.

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.dart.js.deps
*.dart.js.map

# Generated Windows runner glue (regenerated by `flutter build` / `flutter run`)
flutter-desktop-app/windows/flutter/ephemeral/
flutter-desktop-app/network_log_viewer_new/build/
flutter-desktop-app/network_log_viewer_new/.dart_tool/

# --- Python launcher ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env

# --- IDE / editors ---
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini

# --- Local runtime data (never commit real traffic or databases) ---
*.db
*.db-shm
*.db-wal
*.db-journal
*.log
*.sqlite
*.sqlite3

# --- Packaged / signed artifacts ---
*.xpi
*.zip
*.msix
*.msixbundle
*.appx
*.appxbundle
*.exe
*.msi
dist/
out/
installer/output/
installer/cert/

# --- Signing keys and credentials (never commit) ---
*.pem
*.key
*.jks
*.keystore
*.p12
*.pfx
secrets.json

# --- Doc / spec / prompt clutter (only root README stays) ---
*.md
!README.md
opencode-prompts/

# --- OS junk ---
*.tmp
*.bak
*~
flutter-desktop-app/network_log_viewer_new/
